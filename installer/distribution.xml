<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Nimbus __VERSION__</title>
  <organization>com.javi</organization>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true"/>
  <choices-outline>
    <line choice="vst3"/>
    <line choice="au"/>
    <line choice="app"/>
  </choices-outline>
  <choice id="vst3" title="VST3 plug-in" description="For Ableton Live and most other DAWs. Installs to /Library/Audio/Plug-Ins/VST3.">
    <pkg-ref id="com.javi.nimbus.vst3"/>
  </choice>
  <choice id="au" title="Audio Unit plug-in" description="For Ableton Live, Logic Pro and GarageBand. Installs to /Library/Audio/Plug-Ins/Components.">
    <pkg-ref id="com.javi.nimbus.au"/>
  </choice>
  <choice id="app" title="Standalone app" description="Play Nimbus without a DAW. Installs to /Applications.">
    <pkg-ref id="com.javi.nimbus.app"/>
  </choice>
  <pkg-ref id="com.javi.nimbus.vst3" version="__VERSION__">vst3.pkg</pkg-ref>
  <pkg-ref id="com.javi.nimbus.au" version="__VERSION__">au.pkg</pkg-ref>
  <pkg-ref id="com.javi.nimbus.app" version="__VERSION__">app.pkg</pkg-ref>
</installer-gui-script>
